# PitchPilot voice Worker — required secret NAMES only. Never commit real values.
# Set these in Cloudflare with: wrangler secret put <NAME>

# ElevenLabs account + agent (native Twilio integration)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Colleague's Convex deployment HTTP-actions origin (…convex.site) + shared secret
CONVEX_SITE_URL=
VOICE_SHARED_SECRET=

# Non-secret var (also set in wrangler.jsonc "vars"): "true" only for Stage-1 test
FAKE_CALL=false
