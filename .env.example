# PitchPilot voice Worker — required secret NAMES only. Never commit real values.
# Set these in Cloudflare with: wrangler secret put <NAME>

# ElevenLabs account + agent (native Twilio integration)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Colleague's Convex deployment HTTP-actions origin (…convex.site) + shared secret
CONVEX_SITE_URL=
VOICE_SHARED_SECRET=

# Non-secret vars (can also live in wrangler.jsonc "vars"):
FAKE_CALL=false               # "true" only for the Stage-1 contract test
CALL_RECORDING_ENABLED=true   # record calls + save to Convex; "false" to disable (needs consent)
# RINGING_TIMEOUT_SECS=25     # ring this long before giving up (ElevenLabs default 60)
# REQUEST_TIMEOUT_MS=12000    # outbound request timeout in ms (optional)
# ELEVENLABS_API_BASE=        # override API origin (tests only; default api.elevenlabs.io)
